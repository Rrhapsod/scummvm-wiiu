+/* Wii U port addition: Groovie uses packed RGBA8888, not RGB888. Keep this
+   no-blend conversion out of the generic per-pixel format dispatcher. Alpha
+   is intentionally ignored, exactly as in BlitNtoN with an RGB565 target. */
+static void Blit_RGBA8888_RGB565(SDL_BlitInfo *info)
+{
+    int y, x;
+    Uint8 *srcrow = info->src;
+    Uint8 *dstrow = info->dst;
+    const int width = info->dst_w;
+
+    for (y = 0; y < info->dst_h; ++y) {
+        const Uint32 *src = (const Uint32 *)srcrow;
+        Uint16 *dst = (Uint16 *)dstrow;
+        for (x = 0; x < width; ++x) {
+            const Uint32 pixel = src[x];
+            dst[x] = (Uint16)(((pixel >> 16) & 0xf800) |
+                              ((pixel >> 13) & 0x07e0) |
+                              ((pixel >> 11) & 0x001f));
+        }
+        srcrow += width * 4 + info->src_skip;
+        dstrow += width * 2 + info->dst_skip;
+    }
+}
