--- /dev/null
+++ b/src/joystick/wiiu/SDL_wiiupointer.h
@@ -0,0 +1,165 @@
+/* Local ScummVM Wii U extension. zlib license; see SDL_wiiujoystick.c.
+ * Opt in with SDL_WIIU_REMOTE_POINTER=1. Reuse the driver's KPAD samples.
+ * Mouse IDs 0x57494900..03 identify the four Remote channels.
+ */
+#ifndef SDL_wiiupointer_h_
+#define SDL_wiiupointer_h_
+
+/* WUT 1.9.1 imports this Cafe OS function but omits its declaration. The
+ * signature matches current WUT's padscore/wpad.h; no dynamic lookup needed. */
+extern void WPADSetSensorBar(BOOL enable);
+
+typedef struct WIIU_RemotePointer {
+    SDL_bool configured;
+    SDL_bool valid;
+    SDL_bool reported;
+    int x, y;
+    Uint32 buttons;
+    Uint32 suppressed;
+} WIIU_RemotePointer;
+
+static WIIU_RemotePointer remotePointers[WIIU_NUM_WPADS];
+static int remotePointerOwner = -1;
+static Uint32 remotePointerYieldUntil;
+
+static SDL_bool WIIU_IsPointingRemote(WPADExtensionType ext)
+{
+    return ext == WPAD_EXT_CORE || ext == WPAD_EXT_MPLUS ||
+           ext == WPAD_EXT_NUNCHUK || ext == WPAD_EXT_MPLUS_NUNCHUK;
+}
+
+static SDL_Window *WIIU_GetPointerWindow(void)
+{
+    SDL_VideoDevice *dev = SDL_GetVideoDevice();
+    SDL_Window *win;
+    if (!dev)
+        return NULL;
+    for (win = dev->windows; win; win = win->next) {
+        if ((win->flags & SDL_WINDOW_SHOWN) && !(win->flags & SDL_WINDOW_WIIU_GAMEPAD_ONLY))
+            return win;
+    }
+    return NULL;
+}
+
+static void WIIU_ReleaseRemotePointer(int channel)
+{
+    WIIU_RemotePointer *p = &remotePointers[channel];
+    const SDL_MouseID id = 0x57494900u + channel;
+    SDL_Window *win = WIIU_GetPointerWindow();
+    if (p->buttons & WPAD_BUTTON_A)
+        SDL_SendMouseButton(win, id, SDL_RELEASED, SDL_BUTTON_LEFT);
+    if (p->buttons & WPAD_BUTTON_B)
+        SDL_SendMouseButton(win, id, SDL_RELEASED, SDL_BUTTON_RIGHT);
+    p->buttons = 0;
+    p->valid = SDL_FALSE;
+    if (remotePointerOwner == channel)
+        remotePointerOwner = -1;
+}
+
+static void WIIU_DisableRemotePointer(int channel)
+{
+    int i;
+    WIIU_RemotePointer *p = &remotePointers[channel];
+    WIIU_ReleaseRemotePointer(channel);
+    if (!p->configured)
+        return;
+    KPADDisableDPD((KPADChan)channel);
+    SDL_zero(*p);
+    for (i = 0; i < WIIU_NUM_WPADS; ++i) {
+        if (remotePointers[i].configured)
+            return;
+    }
+    WPADSetSensorBar(FALSE);
+}
+
+static void WIIU_ConfigureRemotePointer(int channel, WPADExtensionType ext)
+{
+    if (WIIU_IsPointingRemote(ext) && SDL_GetHintBoolean("SDL_WIIU_REMOTE_POINTER", SDL_FALSE)) {
+        if (!remotePointers[channel].configured) {
+            WPADSetSensorBar(TRUE);
+            KPADEnableDPD((KPADChan)channel);
+            remotePointers[channel].configured = SDL_TRUE;
+            SDL_Log("WiiU pointer: enabled IR and external Sensor Bar for channel %d", channel);
+        }
+    } else {
+        WIIU_DisableRemotePointer(channel);
+    }
+}
+
+/* Touch/sticks temporarily own the cursor. Anchor subsequent IR samples while
+ * yielded so an idle Remote cannot snap the pointer back after a touch. */
+static void WIIU_YieldRemotePointer(void)
+{
+    if (remotePointerOwner >= 0 && remotePointers[remotePointerOwner].buttons)
+        return; /* Do not interrupt an IR drag. */
+    remotePointerOwner = -1;
+    remotePointerYieldUntil = SDL_GetTicks() + 350;
+}
+
+static void WIIU_UpdateRemotePointer(int channel, const KPADStatus *kpad, Uint32 held)
+{
+    WIIU_RemotePointer *p = &remotePointers[channel];
+    SDL_Window *win = WIIU_GetPointerWindow();
+    const SDL_MouseID id = 0x57494900u + channel;
+    Uint32 buttons = held & (WPAD_BUTTON_A | WPAD_BUTTON_B);
+    Uint32 pressed;
+    SDL_bool valid, moved = SDL_FALSE, claim;
+    int x = p->x, y = p->y;
+    int threshold;
+    if (!p->configured)
+        return;
+    if (!win || win->w <= 0 || win->h <= 0) {
+        p->suppressed |= buttons;
+        WIIU_ReleaseRemotePointer(channel);
+        return;
+    }
+    p->suppressed &= buttons;
+    buttons &= ~p->suppressed;
+    pressed = buttons & ~p->buttons;
+    /* Positive y is DOWN in KPAD, unlike the Nunchuk stick. Comparisons also
+     * reject NaN/Inf. The [-1,+1] mapping follows libgui's Wii U pointer. */
+    valid = (kpad->posValid == 1 || kpad->posValid == 2) &&
+            kpad->pos.x >= -1.0f && kpad->pos.x <= 1.0f &&
+            kpad->pos.y >= -1.0f && kpad->pos.y <= 1.0f;
+    if (!p->reported || valid != p->valid) {
+        /* Opted-in application diagnostics: code encodes channel and tracking
+         * validity, without pointers to temporary KPAD/window data. */
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = SDL_USEREVENT;
+        event.user.code = 0x57495200 + channel * 2 + (valid ? 1 : 0);
+        SDL_PushEvent(&event);
+        p->reported = SDL_TRUE;
+    }
+    threshold = SDL_max(2, win->w / (remotePointerOwner == channel ? 320 : 100));
+    if (valid) {
+        x = (int)((kpad->pos.x + 1.0f) * 0.5f * (win->w - 1));
+        y = (int)((kpad->pos.y + 1.0f) * 0.5f * (win->h - 1));
+        moved = !p->valid || SDL_abs(x - p->x) >= threshold || SDL_abs(y - p->y) >= threshold;
+    }
+    claim = pressed || (valid && moved && SDL_TICKS_PASSED(SDL_GetTicks(), remotePointerYieldUntil));
+    if (remotePointerOwner >= 0 && remotePointerOwner != channel && remotePointers[remotePointerOwner].buttons)
+        claim = SDL_FALSE;
+    if (claim)
+        remotePointerOwner = channel;
+    if (valid && remotePointerOwner == channel && (moved || pressed)) {
+        /* Position before button-down, including a stationary Remote after a
+         * GamePad touch. Send actual SDL mouse state for drag/clipping logic. */
+        SDL_SendMouseMotion(win, id, 0, x, y);
+        p->x = x;
+        p->y = y;
+    } else if (valid && !SDL_TICKS_PASSED(SDL_GetTicks(), remotePointerYieldUntil)) {
+        p->x = x;
+        p->y = y;
+    }
+    p->valid = valid;
+    if (remotePointerOwner != channel)
+        return;
+    if ((buttons ^ p->buttons) & WPAD_BUTTON_A)
+        SDL_SendMouseButton(win, id, (buttons & WPAD_BUTTON_A) ? SDL_PRESSED : SDL_RELEASED, SDL_BUTTON_LEFT);
+    if ((buttons ^ p->buttons) & WPAD_BUTTON_B)
+        SDL_SendMouseButton(win, id, (buttons & WPAD_BUTTON_B) ? SDL_PRESSED : SDL_RELEASED, SDL_BUTTON_RIGHT);
+    p->buttons = buttons;
+}
+
+#endif
