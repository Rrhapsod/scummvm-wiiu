+
+/* Speed-based low-pass filtering (1 Euro principle, Casiez/Roussel/Vogel,
+ * CHI 2012; https://gery.casiez.net/1euro/). Independently implemented here.
+ * Filter before integer conversion, in 1280x720 reference units so changing
+ * display resolution does not change the normalized tracking response.
+ * Stronger stabilization at rest, higher cutoff while moving; no spatial
+ * dead zone. A shared cutoff preserves the direction of diagonal movement. */
+static float WIIU_PointerAlpha(float cutoff, float seconds)
+{
+    const float scaled = 6.28318530718f * cutoff * seconds;
+    return scaled / (1.0f + scaled);
+}
+
+static void WIIU_FilterRemotePointer(WIIU_RemotePointer *p, SDL_Window *win,
+                                     const KPADStatus *kpad, int *x, int *y)
+{
+    const Uint32 now = SDL_GetTicks();
+    const Uint32 elapsed = now - p->filterTicks;
+    const float rawX = (kpad->pos.x + 1.0f) * 640.0f;
+    const float rawY = (kpad->pos.y + 1.0f) * 360.0f;
+    const SDL_bool reset = !p->filterReady || p->filterWidth != win->w || p->filterHeight != win->h || elapsed > 250;
+    if (reset) {
+        /* Never interpolate across tracking/ownership loss, resize, suspend
+         * or a long frame gap. Buttons still use the normal immediate path. */
+        p->smoothX = rawX;
+        p->smoothY = rawY;
+        p->velocityX = p->velocityY = 0.0f;
+        p->filterReady = SDL_TRUE;
+    } else if (elapsed) {
+        const float seconds = elapsed * 0.001f;
+        const float derivativeAlpha = WIIU_PointerAlpha(1.0f, seconds);
+        float speed, alpha;
+        p->velocityX += derivativeAlpha * ((rawX - p->rawX) / seconds - p->velocityX);
+        p->velocityY += derivativeAlpha * ((rawY - p->rawY) / seconds - p->velocityY);
+        speed = SDL_max(SDL_fabsf(p->velocityX), SDL_fabsf(p->velocityY));
+        alpha = WIIU_PointerAlpha(0.8f + 0.03f * speed, seconds);
+        p->smoothX += alpha * (rawX - p->smoothX);
+        p->smoothY += alpha * (rawY - p->smoothY);
+    }
+    if (reset || elapsed) {
+        p->rawX = rawX;
+        p->rawY = rawY;
+        p->filterTicks = now;
+    }
+    p->filterWidth = win->w;
+    p->filterHeight = win->h;
+    *x = (int)((p->smoothX / 1280.0f) * (win->w - 1));
+    *y = (int)((p->smoothY / 720.0f) * (win->h - 1));
 }
 
